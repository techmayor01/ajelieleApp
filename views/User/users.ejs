		<!-- Slimscroll JS -->
		<script src="assets/js/jquery.slimscroll.min.js" type="f19cf3fd9aef1a1f670f2ea5-text/javascript"></script>

		<!-- Datatable JS -->
		<script src="assets/js/jquery.dataTables.min.js" type="f19cf3fd9aef1a1f670f2ea5-text/javascript"></script>
		<script src="assets/js/dataTables.bootstrap5.min.js" type="f19cf3fd9aef1a1f670f2ea5-text/javascript"></script>

		<!-- Datetimepicker JS -->
		<script src="assets/js/moment.min.js" type="f19cf3fd9aef1a1f670f2ea5-text/javascript"></script>
		<script src="assets/js/bootstrap-datetimepicker.min.js" type="f19cf3fd9aef1a1f670f2ea5-text/javascript"></script>
		
		<!-- Bootstrap Core JS -->
        <script src="assets/js/bootstrap.bundle.min.js" type="f19cf3fd9aef1a1f670f2ea5-text/javascript"></script>

		<!-- Summernote JS -->
	    <script src="assets/plugins/summernote/summernote-bs4.min.js" type="f19cf3fd9aef1a1f670f2ea5-text/javascript"></script>

		<!-- Select2 JS -->
		<script src="assets/plugins/select2/js/select2.min.js" type="f19cf3fd9aef1a1f670f2ea5-text/javascript"></script>

	<!-- Color Picker JS -->
