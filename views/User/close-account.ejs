<body>
	<div id="global-loader" >
		<div class="whirly-loader"> </div>
	</div>
	<!-- Main Wrapper -->
	<div class="main-wrapper">
		 <%- include('../partials/header') %>

		<div class="page-wrapper">
			<div class="content">
				<form action="/close-account" method="POST">
					<div class="page-header">
						<div class="add-item d-flex">
							<div class="page-title">
								<h4 class="fw-bold">Close Account</h4>
								<h6>Close and Moves Sales</h6>
							</div>
						</div>
						<ul class="table-top-head">
							<div class="card-body">
								<div class="row row-gap-2 align-items-end">
									<div class="col-md-3" style="width: 70%;">				
										<div class="input-icon-end position-relative">
											<input type="date" id="payment_date" name="payment_date" class="form-control" placeholder="dd/mm/yyyy">
										</div>
										<script>
											const today = new Date().toISOString().split('T')[0];
											document.getElementById('payment_date').value = today;
										</script>
									</div>
									<div class="col-md-3">
										<button class="btn btn-primary">Submit</button>
									</div>
								</div>
							</div>
						</ul>
					</div>
				</form>
				
					<form action="/close-account" method="get">
						<div class="card">
							<div class="card-body">
								<div class="row row-gap-2 align-items-end">
									  <div class="col-md-6">
										<label class="form-label">Choose Your Date</label>	
										<div style="display: flex; align-items: center; gap: 5px;">
											<input type="date" name="startDate" id="startDate" class="form-control"  />
											<span class="text-gray-500">to</span>
											<input type="date" name="endDate" id="endDate" class="form-control"/>
										</div>
									</div>
									<div class="col-md-3">
										<button class="btn btn-primary">Submit</button>
									</div>
								</div>
							</div>
						</div>
					</form>
					
					<% if (closingAccounts && closingAccounts.length > 0) { %>
  <div class="card mt-3">
    <div class="table-responsive">
      <table class="table">
        <thead class="thead-light">
          <tr>
            <th>Date</th>
            <th>Total Sales</th>
            <th>Total Debtors Payment</th>
            <th>Total Credit Sales</th>
            <th>Total Expenses</th>
            <th>Closing Balance</th>
          </tr>
        </thead>
        <tbody>
          <% closingAccounts.forEach(account => { %>
            <tr>
              <td class="p-3"><%= new Date(account.date).toLocaleDateString() %></td>
              <td class="p-3">₦<%= account.totalSales.toLocaleString() %></td>
              <td class="p-3">₦<%= account.totalDebtorsPayment.toLocaleString() %></td>
              <td class="p-3">₦<%= account.totalCreditSales.toLocaleString() %></td>
              <td class="p-3">₦<%= account.totalExpenses.toLocaleString() %></td>
              <td class="p-3">₦<%= account.closingBalance.toLocaleString() %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
<% } else if (query.startDate && query.endDate) { %>
  <div class="alert alert-warning text-center mt-3">
    No closing accounts found for the selected date range.
  </div>
<% } %>
			</div>
			<div class="footer d-sm-flex align-items-center justify-content-between border-top bg-white p-3">
				<p class="mb-0 text-gray-9">2025 &copy; AJELIELE. All Right Reserved</p>
				<p>Developed by <a href="javascript:void(0);" class="text-primary">TECH MAYOR GROUPS</a></p>
			</div>
		</div>
	</div>
	<!-- /Main Wrapper -->


	 <div class="modal fade" id="notificationModal" tabindex="-1" role="dialog" aria-labelledby="notificationModalLabel" aria-hidden="true">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					<div class="page-wrapper-new p-0">
						<div class="content p-5 px-3 text-center">
								<span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2"><i class="ti ti-trash fs-24 text-danger"></i></span>
								<h4 class="fs-20 fw-bold mb-2 mt-1">Notification</h4>
								<p class="mb-0 fs-16">message here</p>
						</div>
					</div>
				</div>
			</div>
		</div>
		<script>
		document.querySelector('form[action="/close-account"]').addEventListener('submit', function (e) {
		e.preventDefault();
		
		const payment_date = document.querySelector('#payment_date').value;

		fetch('/close-account', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ payment_date })
		})
		.then(res => res.json())
		.then(data => {
			const msgElement = document.querySelector('#notificationModal .fs-16');

			if (data.message) {
			msgElement.textContent = data.message;

			if (!data.error) {
				document.querySelector('#notificationModal span')
				.classList.remove('bg-danger-transparent');
				document.querySelector('#notificationModal span')
				.classList.add('bg-success-transparent');

				document.querySelector('#notificationModal i')
				.classList.remove('ti-trash', 'text-danger');
				document.querySelector('#notificationModal i')
				.classList.add('ti-check', 'text-success');
			} else {
				document.querySelector('#notificationModal span')
				.classList.remove('bg-success-transparent');
				document.querySelector('#notificationModal span')
				.classList.add('bg-danger-transparent');

				document.querySelector('#notificationModal i')
				.classList.remove('ti-check', 'text-success');
				document.querySelector('#notificationModal i')
				.classList.add('ti-trash', 'text-danger');
			}
			}

			// Show modal
			new bootstrap.Modal(document.getElementById('notificationModal')).show();
		})
		.catch(err => {
			document.querySelector('#notificationModal .fs-16').textContent = 'Unexpected error occurred';
			new bootstrap.Modal(document.getElementById('notificationModal')).show();
		});
		});
		</script>

