<!DOCTYPE html>
<html lang="en">
<head>

		<!-- Meta Tags -->
		<meta charset="utf-8">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="description" content="Dreams POS is a powerful Bootstrap based Inventory Management Admin Template designed for businesses, offering seamless invoicing, project tracking, and estimates.">
		<meta name="keywords" content="inventory management, admin dashboard, bootstrap template, invoicing, estimates, business management, responsive admin, POS system">
		<meta name="author" content="Dreams Technologies">
		<meta name="robots" content="index, follow">
		<title>AJELIELE AND SONS - STAFF ACTIVITIES</title>

		<!-- Favicon -->
        <link rel="shortcut icon" type="image/x-icon" href="assets/img/favicon.png">

		<!-- Apple Touch Icon -->
		<link rel="apple-touch-icon" sizes="180x180" href="assets/img/apple-touch-icon.png">
		
		<!-- Bootstrap CSS -->
        <link rel="stylesheet" href="assets/css/bootstrap.min.css">

		<!-- Select2 CSS -->
		<link rel="stylesheet" href="assets/plugins/select2/css/select2.min.css">

		<!-- Datetimepicker CSS -->
		<link rel="stylesheet" href="assets/css/bootstrap-datetimepicker.min.css">

		<!-- Datatable CSS -->
		<link rel="stylesheet" href="assets/css/dataTables.bootstrap5.min.css">
		
        <!-- Fontawesome CSS -->
		<link rel="stylesheet" href="assets/plugins/fontawesome/css/fontawesome.min.css">
		<link rel="stylesheet" href="assets/plugins/fontawesome/css/all.min.css">

		<!-- Tabler Icon CSS -->
		<link rel="stylesheet" href="assets/plugins/tabler-icons/tabler-icons.min.css">

		<!-- Color Picker Css -->
		<link rel="stylesheet" href="assets/plugins/%40simonwep/pickr/themes/nano.min.css">

	    <!-- Main CSS -->
        <link rel="stylesheet" href="assets/css/style.css">
		
</head>
<body>
		
		<div id="global-loader" >
			<div class="whirly-loader"> </div>
		</div>

		<!-- Main Wrapper -->
        <div class="main-wrapper">
		<%- include('../Partials/header') %>

			

			<div class="page-wrapper">
				<div class="content">
					<div class="page-header">
						<div class="add-item d-flex">
							<div class="page-title">
								<h4>Staff Attendance</h4>
								<h6>Manage Staff Attendance</h6>
							</div>
						</div>
						<ul class="table-top-head">
							<li class="me-2">
								<a data-bs-toggle="tooltip" data-bs-placement="top" title="Pdf"><img src="assets/img/icons/pdf.svg" alt="img"></a>
							</li>
							<li class="me-2">
								<a data-bs-toggle="tooltip" data-bs-placement="top" title="Excel"><img src="assets/img/icons/excel.svg" alt="img"></a>
							</li>
							<li class="me-2">
								<a data-bs-toggle="tooltip" data-bs-placement="top" title="Refresh"><i class="ti ti-refresh"></i></a>
							</li>
							<li class="me-2">
								<a data-bs-toggle="tooltip" data-bs-placement="top" title="Collapse" id="collapse-header"><i class="ti ti-chevron-up"></i></a>
							</li>
						</ul>
					</div>
					<!-- /product list -->
					<div class="card">
						<form action="staffLogs" method="get">
							  <input type="hidden" name="branchId" value="<%= selectedBranch %>" />
						<div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
							<div class="search-set">
							<div class="search-input">
								<span class="btn-searchset"><i class="ti ti-search fs-14 feather-search"></i></span>
							</div>
							</div>

							<div class="d-flex table-dropdown my-xl-auto right-content align-items-center gap-3" style="width: 58%;">
							<div style="display: flex; align-items: center; gap: 5px;">
								<input type="date" name="startDate" id="startDate" class="form-control" value="<%= startDate %>" />
								<span class="text-gray-500">to</span>
								<input type="date" name="endDate" id="endDate" class="form-control" value="<%= endDate %>" />
							</div>

							<!-- Status dropdown -->
							<div class="dropdown">
								<input type="hidden" name="status" id="statusInput" value="<%= selectedStatus %>" />
								<a href="javascript:void(0);" class="dropdown-toggle btn btn-white btn-md d-inline-flex align-items-center" data-bs-toggle="dropdown">
								<%= selectedStatus || "Select Status" %>
								</a>
								<ul class="dropdown-menu dropdown-menu-end p-3">
								<li><a href="javascript:void(0);" class="dropdown-item rounded-1" onclick="document.getElementById('statusInput').value='Active'; this.closest('form').submit();">Active</a></li>
								<li><a href="javascript:void(0);" class="dropdown-item rounded-1" onclick="document.getElementById('statusInput').value='Closed'; this.closest('form').submit();">Closed</a></li>
								</ul>
							</div>
							</div>
						</div>
						</form>

						<div class="card-body p-0">
							<div class="table-responsive">
								<table class="table ">
									<thead class="thead-light">
										<tr>
											<th>Employee</th>
											<th>Status</th>
											<th>Clock In</th>
											<th>Clock Out</th>
											<th>Total Hours</th>
										</tr>
									</thead>
									<tbody>
  <% logs.forEach(log => { 
      const clockIn = log.signInTime ? new Date(log.signInTime) : null;
      const clockOut = log.signOutTime ? new Date(log.signOutTime) : null;

      // Calculate total hours
      let totalHours = "";
      if (clockIn && clockOut) {
        const diffMs = clockOut - clockIn;
        const hours = Math.floor(diffMs / (1000 * 60 * 60));
        const minutes = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));
        totalHours = `${hours}h ${minutes}m`;
      }

      // Use status directly from backend
      const status = log.status; // "Active" or "Closed"
  %>
  <tr>
    <td>
      <div class="d-flex align-items-center">
        <div>
          <h6><a href="#"><%= log.user.fullname %></a></h6>
          <span><%= log.user.role?.name || "Staff" %></span>
        </div>
      </div>
    </td>
    <td>
      <% if (status === "Active") { %>
        <span class="badge badge-success d-inline-flex align-items-center badge-xs">
          <i class="ti ti-point-filled me-1"></i>Active
        </span>
      <% } else { %>
        <span class="badge badge-secondary d-inline-flex align-items-center badge-xs">
          <i class="ti ti-point-filled me-1"></i>Closed
        </span>
      <% } %>
    </td>
    <td><%= clockIn ? clockIn.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : "-" %></td>
    <td><%= clockOut ? clockOut.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : "-" %></td>
    <td><%= totalHours || "-" %></td>
  </tr>
  <% }) %>
</tbody>


								</table>
							</div>
						</div>
					</div>
					<!-- /product list -->

				</div>
				<div class="footer d-sm-flex align-items-center justify-content-between border-top bg-white p-3">
					<p class="mb-0">2014 - 2025 &copy; DreamsPOS. All Right Reserved</p>
					<p>Designed &amp; Developed by <a href="javascript:void(0);" class="text-primary">Dreams</a></p>
				</div>
			</div>
        </div>
		<!-- /Main Wrapper -->

		<!-- jQuery -->
        <script src="assets/js/jquery-3.7.1.min.js" type="eeebf3e89f5c8d22fe0797d2-text/javascript"></script>
		
		<!-- Bootstrap Core JS -->
        <script src="assets/js/bootstrap.bundle.min.js" type="eeebf3e89f5c8d22fe0797d2-text/javascript"></script>

        <!-- Feather Icon JS -->
		<script src="assets/js/feather.min.js" type="eeebf3e89f5c8d22fe0797d2-text/javascript"></script>

		<!-- Slimscroll JS -->
		<script src="assets/js/jquery.slimscroll.min.js" type="eeebf3e89f5c8d22fe0797d2-text/javascript"></script>

		<!-- Datatable JS -->
		<script src="assets/js/jquery.dataTables.min.js" type="eeebf3e89f5c8d22fe0797d2-text/javascript"></script>
		<script src="assets/js/dataTables.bootstrap5.min.js" type="eeebf3e89f5c8d22fe0797d2-text/javascript"></script>
		
		<!-- Datetimepicker JS -->
		<script src="assets/js/moment.min.js" type="eeebf3e89f5c8d22fe0797d2-text/javascript"></script>
		<script src="assets/js/bootstrap-datetimepicker.min.js" type="eeebf3e89f5c8d22fe0797d2-text/javascript"></script>

		<!-- Color Picker JS -->
		<script src="assets/plugins/%40simonwep/pickr/pickr.es5.min.js" type="eeebf3e89f5c8d22fe0797d2-text/javascript"></script>

		<!-- Custom JS -->
		<script src="assets/js/theme-colorpicker.js" type="eeebf3e89f5c8d22fe0797d2-text/javascript"></script>
		<script src="assets/js/script.js" type="eeebf3e89f5c8d22fe0797d2-text/javascript"></script>
		

    <script src="../../cdn-cgi/scripts/7d0fa10a/cloudflare-static/rocket-loader.min.js" data-cf-settings="eeebf3e89f5c8d22fe0797d2-|49" defer></script><script defer src="https://static.cloudflareinsights.com/beacon.min.js/vcd15cbe7772f49c399c6a5babf22c1241717689176015" integrity="sha512-ZpsOmlRQV6y907TI0dKBHq9Md29nnaEIPlkf84rnaERnq6zvWvPUqr2ft8M1aS28oN72PdrCzSjY4U6VaAw1EQ==" data-cf-beacon='{"rayId":"951ebb474ff3412e","version":"2025.6.2","serverTiming":{"name":{"cfExtPri":true,"cfEdge":true,"cfOrigin":true,"cfL4":true,"cfSpeedBrain":true,"cfCacheStatus":true}},"token":"3ca157e612a14eccbb30cf6db6691c29","b":1}' crossorigin="anonymous"></script>
</body>

</html>