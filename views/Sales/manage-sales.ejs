	<!-- Main Wrapper -->
	<div class="main-wrapper">
		<%- include('../Partials/header') %>

		<div class="page-wrapper">
			<div class="content">
				<div class="page-header">
					<div class="add-item d-flex">
						<div class="page-title">
							<h4>Sales Orders</h4>
							<h6>Manage Your sales orders</h6>
						</div>
					</div>
					<ul class="table-top-head">
						<li>
							<a data-bs-toggle="tooltip" data-bs-placement="top" title="Pdf"><img src="assets/img/icons/pdf.svg" alt="img"></a>
						</li>
						<li>
							<a data-bs-toggle="tooltip" data-bs-placement="top" title="Excel"><img src="assets/img/icons/excel.svg" alt="img"></a>
						</li>	
						<li>
							<a data-bs-toggle="tooltip" data-bs-placement="top" title="Refresh"><i class="ti ti-refresh"></i></a>
						</li>
						<li>
							<a data-bs-toggle="tooltip" data-bs-placement="top" title="Collapse" id="collapse-header"><i class="ti ti-chevron-up"></i></a>
						</li>
					</ul>
					<div class="page-btn">
						<a href="/createSales" class="btn btn-primary"><i class="ti ti-circle-plus me-1"></i>Add Sales</a>
					</div>
				</div>
				
				<!-- /product list -->
				<div class="card">
					<div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
						<div class="search-set">
							<div class="search-input">
								<span class="btn-searchset"><i class="ti ti-search fs-14 feather-search"></i></span>
							</div>
						</div>
						<div class="d-flex table-dropdown my-xl-auto right-content align-items-center flex-wrap row-gap-3">
							
							<div class="dropdown">
								<a href="javascript:void(0);" class="dropdown-toggle btn btn-white btn-md d-inline-flex align-items-center" data-bs-toggle="dropdown">
									Sort By : Last 7 Days
								</a>
								<ul class="dropdown-menu  dropdown-menu-end p-3">
									<li>
										<a href="javascript:void(0);" class="dropdown-item rounded-1">Recently Added</a>
									</li>
									<li>
										<a href="javascript:void(0);" class="dropdown-item rounded-1">Ascending</a>
									</li>
									<li>
										<a href="javascript:void(0);" class="dropdown-item rounded-1">Desending</a>
									</li>
									<li>
										<a href="javascript:void(0);" class="dropdown-item rounded-1">Last Month</a>
									</li>
									<li>
										<a href="javascript:void(0);" class="dropdown-item rounded-1">Last 7 Days</a>
									</li>
								</ul>
							</div>
						</div>
					</div>
					<div class="card-body p-0">
						<div class="table-responsive">
							<table class="table ">
								<thead class="thead-light">
									<tr>
										<th>Customer</th>
										<th>Invoice_no</th>
										<th>Date</th>
										<th>Grand Total</th>
										<th>Paid</th>
										<th>Due</th>
										<th>Payment Ref</th>
										<th>Operator</th>
										<th></th>
									</tr>
								</thead>
								<tbody class="sales-list">
  <% invoices.forEach(invoice => { %>
    <tr>
      <td>
        <a href="javascript:void(0);">
          <%= invoice.customer_name || (invoice.customer_id && invoice.customer_id.customer_name) || 'N/A' %>
        </a>
      </td>
      <td><%= invoice.receipt_no %></td>
		<td data-created="<%= invoice.createdAt %>">
		<%= invoice.payment_date ? new Date(invoice.payment_date).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }) : '' %>
		</td>
      <td>₦<%= invoice.grand_total?.toFixed(2) %></td>
      <td>₦<%= invoice.paid_amount?.toFixed(2) %></td>
      <td>₦<%= invoice.remaining_amount?.toFixed(2) %></td>
      <td>
		<%= invoice.paymentRef || 'N/A' %>
      </td>
      <td>
        <%= invoice.createdBy.role.name || 'N/A' %>
      </td>
      <td class="text-center">
        <a class="action-set" href="javascript:void(0);" data-bs-toggle="dropdown" aria-expanded="true">
          <i class="fa fa-ellipsis-v" aria-hidden="true"></i>
        </a>
        <ul class="dropdown-menu">
			<li>
				<a href="/update-invoice/<%= invoice._id %>" class="dropdown-item edit-sale-btn" >
					<i data-feather="edit" class="info-img"></i>Edit Sale
				</a>		  
			</li>
			<li>
				<a href="#" data-bs-toggle="modal" data-bs-target="#delete"  class="dropdown-item mb-0">
				<i data-feather="trash-2" class="info-img"></i>Delete Sale
				</a>
			</li>
			<li>
				<a class="dropdown-item" href="/receipt/<%= invoice._id %>">
					<i data-feather="printer" class="feather-printer"></i> Print Receipt
				</a>
			</li>
        </ul>
      </td>
    </tr>
  <% }) %>
</tbody>

							</table>
