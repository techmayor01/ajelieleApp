<body>
		
		<div id="global-loader" >
			<div class="whirly-loader"> </div>
		</div>
	
	
		 
		<!-- Main Wrapper -->
        <div class="main-wrapper">
		<%- include('../Partials/header') %>

		

			<div class="page-wrapper">
				<div class="content">
					<div class="page-header">
						<div class="page-title">
							<h4>Profile</h4>
							<h6>User Profile</h6>
						</div>
					</div>
					<!-- /product list -->
					 <form action="/update-profile" method="post">
						 <div class="card">
							 <div class="card-header">
							 <h4>Profile</h4>
							 </div>
							 <div class="card-body profile-body">
								 <h5 class="mb-2"><i class="ti ti-user text-primary me-1"></i>Basic Information</h5>
								 <div class="row">
									 <div class="col-lg-6 col-sm-12">
										 <div class="mb-3">
											 <label class="form-label">Full Name<span class="text-danger ms-1">*</span></label>
											 <input type="text" name="fullname" class="form-control" value="<%= user.fullname %>">
										 </div>
									 </div>
									 <div class="col-lg-6 col-sm-12">
										 <div class="mb-3">
											 <label class="form-label">Branch<span class="text-danger ms-1">*</span></label>
											 <input type="text" class="form-control" readonly value="<%= user.branch.branch_name %>">
										 </div>
									 </div>
									 <div class="col-lg-6 col-sm-12">
										 <div class="mb-3">
											 <label>User Name<span class="text-danger ms-1">*</span></label>
											 <input type="text" name="username" class="form-control" value="<%= user.username %>">
										 </div>
									 </div>
									 <div class="col-lg-6 col-sm-12">
										 <div class="mb-3">
											 <label class="form-label">Role<span class="text-danger ms-1">*</span></label>
											 <input type="text" readonly value="<%= user.role.name %>" class="form-control">
										 </div>
									 </div>
									 
									 <!-- Change password section -->
									  <!-- ENTER CURRENT PASSWORD, NEW PASSWORD, AND CONFIRM NEW PASSWORD -->
									 <h4 class="mb-2">Update Password</h4>

									 <div class="col-lg-6 col-sm-12">
										 <div class="mb-3">
											 <label class="form-label">Current Password<span class="text-danger ms-1">*</span></label>
											 <div class="pass-group">
												 <input type="password" name="currentPassword" autocomplete="new-password" class="pass-input form-control" placeholder="**********">
												 <i class="ti ti-eye-off toggle-password"></i>
											 </div>
										 </div>
										  <div class="mb-3">
											 <label class="form-label">New Password<span class="text-danger ms-1">*</span></label>
											 <div class="pass-group">
												 <input type="password" name="newPassword" class="pass-input form-control" placeholder="**********">
												 <i class="ti ti-eye-off toggle-password"></i>
											 </div>
										 </div>
									 </div>
									 <div class="col-12 d-flex justify-content-end">
										 <a href="/dashboard" class="btn btn-secondary me-2 shadow-none">Cancel</a>
										 <button class="btn btn-primary shadow-none">Save Changes</button>
									 </div>
								 </div>
							 </div>
						 </div>
					 </form>
					<!-- /product list -->
				</div>
				<div class="footer d-sm-flex align-items-center justify-content-between border-top bg-white p-3">
                    <p class="mb-0 text-gray-9">2025 &copy; AJELIELE. All Right Reserved</p>
                    <p>Developed by <a href="javascript:void(0);" class="text-primary">Tech Mayor Groups</a></p>
                </div>
			</div>
        </div>

		
		<!-- /Main Wrapper -->
		  

		 
