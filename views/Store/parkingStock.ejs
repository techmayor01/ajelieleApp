<body>
    <div id="global-loader" >
        <div class="whirly-loader"> </div>
    </div>
    <!-- Main Wrapper -->
    <div class="main-wrapper">
        <%- include('../partials/header') %>
        
        <div class="page-wrapper">
            <div class="content">
                <div class="page-header">
                    <div class="add-item d-flex">
                        <div class="page-title">
                            <h4 class="fw-bold"><%= store.storeName %> List</h4>
                            <h6>Manage your products</h6>
                        </div>
                    </div>
                </div>
                
                <!-- /product list -->
                <div class="card">
                    <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
                        <div class="search-set">
                            <div class="search-input">
                                <span class="btn-searchset"><i class="ti ti-search fs-14 feather-search"></i></span>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive" style="padding: 20px;">
                        <table id="stockTable" style="width: 100%;">
                        <thead style="text-align: left;">
                            <tr>
                            <th style="text-align: left;">Product Name</th>
                            <th>Unit</th>
                            <th>Qty</th>
                            <th>Parked By</th>
                            <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- YOUR LOOP SHOULD BE HERE -->
                            <% stock.forEach(item => { %>
                            <tr>
                                <td><%= item.product?.product %></td>
                                <td><%= item.unitCode %></td>
                                <td><%= item.quantity %></td>
                                <td><%= user.fullname %></td>
                                <td>
                                    <a class="me-2 p-2" 
                                        href="javascript:void(0);"
                                        data-bs-toggle="modal" 
                                        data-bs-target="#editParkingModal"
                                        data-id="<%= item._id %>"
                                        data-store="<%= store._id %>"
                                        data-product="<%= item.product?.product %>"
                                        data-unit="<%= item.unitCode %>"
                                        data-quantity="<%= item.quantity %>">
                                        <i data-feather="edit"></i>
                                    </a>

                                    <a data-bs-toggle="modal" data-bs-target="#delete-modal"
                                    class="p-2 delete-button"
                                    href="javascript:void(0);"
                                    data-id="<%= item._id %>">
                                    <i data-feather="trash-2"></i>
                                    </a>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                        </table>

                        </div>
                    </div>
                </div>
                <!-- /product list -->
            </div>
            <div class="footer d-sm-flex align-items-center justify-content-between border-top bg-white p-3">
                <p class="mb-0 text-gray-9">2025 &copy; AJELIELE. All Right Reserved</p>
                <p>Developed by <a href="javascript:void(0);" class="text-primary">Tech Mayor Groups</a></p>
            </div>
        </div>
    </div>
    <!-- /Main Wrapper -->

    <!-- Import Product -->
    <div class="modal fade" id="editParkingModal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="page-wrapper-new p-0">
                    <div class="content">
                        <div class="modal-header">
                            <div class="page-title">
                                <h4>Edit Product</h4>
                            </div>
                            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <form action="/editParkingStock" method="POST">
                            <!-- Hidden inputs -->
                            <input type="hidden" name="parkingStockId" id="modal_parkingStockId" value="<%= stock._id %>">
                            <input type="hidden" name="parkingStoreId" id="modal_parkingStoreId" value="<%= store._id %>">
                            <input type="hidden" name="unitCode" id="modal_unitCode" value="<%= stock.unitCode %>">

                            <div class="row">
                                <div class="col-lg-12 col-sm-6 col-12">
                                <div class="mb-3">
                                    <label class="form-label">Product<span class="ms-1 text-danger">*</span></label>
                                    <input type="text" class="form-control" name="product" id="modal_product" value="<%= stock.product?.product || '' %>" readonly>
                                </div>
                                </div>

                                <div class="col-sm-12 col-12">
                                <div class="mb-3">
                                    <label>Action<span class="ms-1 text-danger">*</span></label>
                                    <select name="action" class="form-select" required>
                                    <option value="">Select</option>
                                    <option value="increase">Increase</option>
                                    <option value="reduce">Reduce</option>
                                    </select>
                                </div>
                                </div>

                                <div class="col-lg-12 col-sm-6 col-12">
                                <div class="mb-3">
                                    <label class="form-label">QTY<span class="ms-1 text-danger">*</span></label>
                                    <input type="number" name="quantity" class="form-control" required>
                                </div>
                                </div>

                                <div class="col-lg-12 col-sm-6 col-12">
                                <div class="mb-3">
                                    <label class="form-label">QTY Balance<span class="ms-1 text-danger">*</span></label>
                                    <input type="number" name="balance" class="form-control" id="modal_balance" value="<%= stock.quantity %>" disabled>
                                </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-12">
                                <div class="mb-3">
                                    <label class="form-label">Reason</label>
                                    <textarea class="form-control" name="reason" maxlength="60"></textarea>
                                    <p class="mt-1">Maximum 60 Characters</p>
                                </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn me-2 btn-secondary fs-13 fw-medium p-2 px-3 shadow-none" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary fs-13 fw-medium p-2 px-3">Submit</button>
                            </div>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- /Import Product -->

    <!-- delete modal -->
<div class="modal fade" id="delete-modal">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="page-wrapper-new p-0">
        <div class="content p-5 px-3 text-center">
          <span class="rounded-circle d-inline-flex p-2 bg-danger-transparent mb-2">
            <i class="ti ti-trash fs-24 text-danger"></i>
          </span>
          <h4 class="fs-20 text-gray-9 fw-bold mb-2 mt-1">Delete Product</h4>
          <p class="text-gray-6 mb-0 fs-16">Are you sure you want to delete product?</p>

          <form id="deleteParkingStockForm" action="/delete-parking-stock" method="POST">
            <input type="hidden" name="id" id="deleteItemId">
            <div class="modal-footer-btn mt-3 d-flex justify-content-center">
              <button type="button" class="btn me-2 btn-secondary fs-13 fw-medium p-2 px-3 shadow-none" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary fs-13 fw-medium p-2 px-3">Yes Delete</button>
            </div>
          </form>

        </div>
      </div>
    </div>
  </div>
</div>

        
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('editParkingModal');

    let originalBalance = 0;

    modal.addEventListener('show.bs.modal', function (event) {
      const button = event.relatedTarget;

      // Extract data attributes
      const id = button.getAttribute('data-id');
      const store = button.getAttribute('data-store');
      const product = button.getAttribute('data-product');
      const unitCode = button.getAttribute('data-unit');
      const quantity = parseFloat(button.getAttribute('data-quantity')) || 0;

      // Set initial form values
      modal.querySelector('#modal_parkingStockId').value = id;
      modal.querySelector('#modal_parkingStoreId').value = store;
      modal.querySelector('#modal_product').value = product;
      modal.querySelector('#modal_unitCode').value = unitCode;
      modal.querySelector('#modal_balance').value = quantity;

      originalBalance = quantity;

      // Reset the form fields (in case modal is reused)
      modal.querySelector('input[name="quantity"]').value = '';
      modal.querySelector('select[name="action"]').value = '';
    });

    // Handle balance update on quantity or action change
    const qtyInput = modal.querySelector('input[name="quantity"]');
    const actionSelect = modal.querySelector('select[name="action"]');
    const balanceInput = modal.querySelector('#modal_balance');

    function updateBalancePreview() {
      const qty = parseFloat(qtyInput.value) || 0;
      const action = actionSelect.value;

      if (action === 'increase') {
        balanceInput.value = originalBalance + qty;
      } else if (action === 'reduce') {
        balanceInput.value = Math.max(0, originalBalance - qty); // prevent negative values
      } else {
        balanceInput.value = originalBalance;
      }
    }

    // Add event listeners
    qtyInput.addEventListener('input', updateBalancePreview);
    actionSelect.addEventListener('change', updateBalancePreview);
  });
</script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const deleteButtons = document.querySelectorAll('.delete-button');
    const deleteInput = document.getElementById('deleteItemId');

    deleteButtons.forEach(button => {
      button.addEventListener('click', () => {
        const id = button.getAttribute('data-id');
        deleteInput.value = id;
      });
    });
  });
</script>



