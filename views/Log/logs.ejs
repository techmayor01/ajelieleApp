</head>
    <body>
		
		<div id="global-loader" >
			<div class="whirly-loader"> </div>
		</div>

		<!-- Main Wrapper -->
        <div class="main-wrapper">
			<%- include('../Partials/header') %>

			<div class="page-wrapper">
				<div class="content mb-4">
					<div class="page-header">
						<div class="page-title">
							<h4>All Notifications</h4>
							<h6>View all activities</h6>
						</div>
					</div>
					
					<% logs.forEach(log => { %>
  <div class="card mb-3 border shadow-none">
    <div class="px-3 py-3">
      <div class="d-flex align-items-center" 
           data-toggle="tooltip" 
           data-placement="right" 
           title="<%= log.date.toLocaleString() %>">

        <!-- Avatar -->
        <div class="d-flex me-2">
          <a href="/profile/<%= log.operator?._id %>" 
             class="avatar avatar-lg bg-primary avatar-rounded">
            <% if (log.operator?.fullname) { 
                 const initials = log.operator.fullname
                   .split(' ')
                   .map(n => n[0])
                   .join('')
                   .toUpperCase();
            %>
              <span class="avatar-title"><%= initials %></span>
            <% } else { %>
              <span class="avatar-title">??</span>
            <% } %>
          </a>
        </div>

        <!-- Action details -->
        <div class="flex-fill ml-3">
          <p class="text-sm lh-140 mb-0">
            <a href="/profile/<%= log.operator?._id %>" class="h6">
              <%= log.operator?.fullname || "Unknown User" %>
            </a>
            <span>
              <% if (log.action === "delete") { %>
                deleted
              <% } else if (log.action === "edit") { %>
                edited
              <% } else { %>
                performed
              <% } %>
              <%= log.targetModel %>
            </span>
            <a href="javascript:void(0);" class="h6">
              <%= log.particulars %>
            </a>
          </p>
          <small>
            <i class="far fa-clock me-1"></i>
            <%= moment(log.date).fromNow() %>
          </small>
        </div>

      </div>
    </div>
  </div>
<% }) %>

					
				</div>
				<div class="footer d-sm-flex align-items-center justify-content-between border-top bg-white p-3">
					<p class="mb-0">2014 - 2025 &copy; DreamsPOS. All Right Reserved</p>
					<p>Designed &amp; Developed by <a href="javascript:void(0);" class="text-primary">Dreams</a></p>
				</div>
			</div>
        </div>

		<!-- /Main Wrapper -->
		 
		<!-- jQuery -->
        <script src="assets/js/jquery-3.7.1.min.js" type="7e3f3321fd8cca3942c25638-text/javascript"></script>
		
		<!-- Bootstrap Core JS -->
        <script src="assets/js/bootstrap.bundle.min.js" type="7e3f3321fd8cca3942c25638-text/javascript"></script>

        <!-- Feather Icon JS -->
		<script src="assets/js/feather.min.js" type="7e3f3321fd8cca3942c25638-text/javascript"></script>

		<!-- Slimscroll JS -->
		<script src="assets/js/jquery.slimscroll.min.js" type="7e3f3321fd8cca3942c25638-text/javascript"></script>

